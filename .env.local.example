# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# brapi.dev — token do plano grátis (dashboard.brapi.dev)
BRAPI_TOKEN=

# segredo do cron de cotações (/api/cron/prices) — configurar também na Vercel
CRON_SECRET=

# Finnhub — cotações da bolsa americana em US$ (plano grátis, 60 chamadas/min)
# criar conta em finnhub.io e copiar a API key do dashboard; configurar também na Vercel
FINNHUB_TOKEN=

# Pluggy (Open Finance) — dashboard.pluggy.ai > Aplicações
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# opcional: segunda aplicação Pluggy (itens criados em outra conta/aplicação)
PLUGGY_CLIENT_ID_2=
PLUGGY_CLIENT_SECRET_2=
